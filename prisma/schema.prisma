generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("user_status")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  LEFT

  @@map("membership_status")
}

enum RoleScope {
  GLOBAL
  HOUSEHOLD

  @@map("role_scope")
}

enum InvitationStatus {
  ACTIVE
  CONSUMED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

enum RegistrationIntentStatus {
  PENDING
  CONSUMED
  EXPIRED
  CANCELLED

  @@map("registration_intent_status")
}

enum CredentialStatus {
  ACTIVE
  REVOKED
  EXPIRED

  @@map("credential_status")
}

enum TransactionType {
  EXPENSE
  INCOME
  REFUND

  @@map("transaction_type")
}

enum AllocationModule {
  CHILD_CARE
  WARDROBE
  CONSUMABLES
  OTHER

  @@map("allocation_module")
}

enum CareRecordType {
  CHECKUP
  MEDICAL_VISIT
  MEDICATION
  SUPPLEMENT
  OTHER

  @@map("care_record_type")
}

enum WardrobeItemStatus {
  ACTIVE
  STORED
  DONATED
  SOLD
  DISCARDED

  @@map("wardrobe_item_status")
}

enum MediaVisibility {
  PRIVATE
  PUBLIC

  @@map("media_visibility")
}

model AppUser {
  id              String     @id @db.Uuid
  emailNormalized String     @unique(map: "app_users_email_normalized_key") @map("email_normalized") @db.Text
  displayName     String?    @map("display_name") @db.Text
  status          UserStatus @default(PENDING_VERIFICATION)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships                 HouseholdMember[]
  globalRoles                 UserGlobalRole[]
  createdInvitations          Invitation[]         @relation("invitation_creator")
  consumedRegistrationIntents RegistrationIntent[] @relation("intent_consumer")
  createdCredentials          ApiCredential[]      @relation("credential_creator")
  auditLogs                   AuditLog[]           @relation("audit_actor")
  createdTransactions         Transaction[]        @relation("transaction_creator")
  uploadedMedia               MediaAsset[]         @relation("media_uploader")

  @@map("app_users")
}

model Household {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.Text
  timeZone  String   @default("Asia/Shanghai") @map("time_zone") @db.Text
  currency  String   @default("CNY") @db.VarChar(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members                 HouseholdMember[]
  invitations             Invitation[]
  apiCredentials          ApiCredential[]
  auditLogs               AuditLog[]
  idempotencyKeys         IdempotencyKey[]
  categories              Category[]
  paymentAccounts         PaymentAccount[]
  transactions            Transaction[]
  transactionAllocations  TransactionAllocation[]
  babyProfiles            BabyProfile[]
  growthRecords           GrowthRecord[]
  vaccineRecords          VaccineRecord[]
  careRecords             CareRecord[]
  wardrobePurchases       WardrobePurchase[]
  wardrobeItems           WardrobeItem[]
  products                Product[]
  productGroups           ProductGroup[]
  stockEntries            StockEntry[]
  inventoryLogs           InventoryLog[]
  consumablePurchases     ConsumablePurchase[]
  consumablePurchaseItems ConsumablePurchaseItem[]
  mediaAssets             MediaAsset[]
  mediaLinks              MediaLink[]
  productGroupItems       ProductGroupItem[]

  @@map("households")
}

model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String    @unique @db.VarChar(64)
  name        String    @db.Text
  description String?   @db.Text
  scope       RoleScope
  isSystem    Boolean   @default(true) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  memberships HouseholdMember[]
  globalUsers UserGlobalRole[]
  invitations Invitation[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @db.VarChar(96)
  name        String           @db.Text
  description String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserGlobalRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_global_roles")
}

model HouseholdMember {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId String           @map("household_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  roleId      String           @map("role_id") @db.Uuid
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        AppUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([householdId, userId])
  @@index([userId, status])
  @@index([roleId])
  @@map("household_members")
}

model Invitation {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId     String               @map("household_id") @db.Uuid
  roleId          String               @map("role_id") @db.Uuid
  tokenHash       String               @unique @map("token_hash") @db.VarChar(128)
  emailNormalized String?              @map("email_normalized") @db.Text
  status          InvitationStatus     @default(ACTIVE)
  expiresAt       DateTime             @map("expires_at") @db.Timestamptz(3)
  consumedAt      DateTime?            @map("consumed_at") @db.Timestamptz(3)
  createdByUserId String?              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  household       Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  role            Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdBy       AppUser?             @relation("invitation_creator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  intents         RegistrationIntent[]

  @@index([householdId, status, expiresAt])
  @@index([roleId])
  @@index([createdByUserId])
  @@map("invitations")
}

model RegistrationIntent {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invitationId    String                   @map("invitation_id") @db.Uuid
  intentTokenHash String                   @unique @map("intent_token_hash") @db.VarChar(128)
  emailNormalized String                   @map("email_normalized") @db.Text
  status          RegistrationIntentStatus @default(PENDING)
  expiresAt       DateTime                 @map("expires_at") @db.Timestamptz(3)
  consumedById    String?                  @map("consumed_by_id") @db.Uuid
  consumedAt      DateTime?                @map("consumed_at") @db.Timestamptz(3)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  invitation      Invitation               @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  consumedBy      AppUser?                 @relation("intent_consumer", fields: [consumedById], references: [id], onDelete: SetNull)

  @@index([invitationId, status, expiresAt])
  @@index([emailNormalized, status])
  @@index([consumedById])
  @@map("registration_intents")
}

model ApiCredential {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId     String?          @map("household_id") @db.Uuid
  name            String           @db.Text
  keyPrefix       String           @map("key_prefix") @db.VarChar(16)
  secretHash      String           @unique @map("secret_hash") @db.VarChar(128)
  scopes          String[]         @default([])
  status          CredentialStatus @default(ACTIVE)
  expiresAt       DateTime?        @map("expires_at") @db.Timestamptz(3)
  lastUsedAt      DateTime?        @map("last_used_at") @db.Timestamptz(3)
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  household       Household?       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       AppUser          @relation("credential_creator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([householdId, status])
  @@index([createdByUserId])
  @@map("api_credentials")
}

model AuditLog {
  id          BigInt     @id @default(autoincrement())
  householdId String?    @map("household_id") @db.Uuid
  actorUserId String?    @map("actor_user_id") @db.Uuid
  action      String     @db.VarChar(96)
  entityType  String     @map("entity_type") @db.VarChar(96)
  entityId    String?    @map("entity_id") @db.Text
  requestId   String?    @map("request_id") @db.VarChar(128)
  beforeData  Json?      @map("before_data")
  afterData   Json?      @map("after_data")
  metadata    Json?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  actor       AppUser?   @relation("audit_actor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([householdId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model IdempotencyKey {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId    String    @map("household_id") @db.Uuid
  scope          String    @db.VarChar(96)
  key            String    @db.VarChar(128)
  requestHash    String    @map("request_hash") @db.VarChar(128)
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  household      Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model Category {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId String?                 @map("household_id") @db.Uuid
  parentId    String?                 @map("parent_id") @db.Uuid
  code        String                  @db.VarChar(64)
  name        String                  @db.Text
  module      AllocationModule
  isSystem    Boolean                 @default(false) @map("is_system")
  isActive    Boolean                 @default(true) @map("is_active")
  sortOrder   Int                     @default(0) @map("sort_order")
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  household   Household?              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  parent      Category?               @relation("category_tree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]              @relation("category_tree")
  allocations TransactionAllocation[]

  @@unique([householdId, code])
  @@index([parentId])
  @@index([householdId, module, isActive])
  @@map("categories")
}

model PaymentAccount {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId  String        @map("household_id") @db.Uuid
  name         String        @db.Text
  type         String        @db.VarChar(32)
  currency     String        @default("CNY") @db.VarChar(3)
  isActive     Boolean       @default(true) @map("is_active")
  sortOrder    Int           @default(0) @map("sort_order")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([householdId, name])
  @@index([householdId, isActive, sortOrder])
  @@map("payment_accounts")
}

model Transaction {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId      String                  @map("household_id") @db.Uuid
  type             TransactionType
  amount           Decimal                 @db.Decimal(14, 2)
  currency         String                  @default("CNY") @db.VarChar(3)
  transactionAt    DateTime                @map("transaction_at") @db.Timestamptz(3)
  paymentAccountId String?                 @map("payment_account_id") @db.Uuid
  merchant         String?                 @db.Text
  note             String?                 @db.Text
  createdByUserId  String                  @map("created_by_user_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?               @map("deleted_at") @db.Timestamptz(3)
  household        Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  paymentAccount   PaymentAccount?         @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  createdBy        AppUser                 @relation("transaction_creator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  allocations      TransactionAllocation[]

  @@index([householdId, transactionAt(sort: Desc), id])
  @@index([householdId, type, transactionAt(sort: Desc)])
  @@index([paymentAccountId])
  @@index([createdByUserId])
  @@map("transactions")
}

model TransactionAllocation {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId        String              @map("household_id") @db.Uuid
  transactionId      String              @map("transaction_id") @db.Uuid
  categoryId         String?             @map("category_id") @db.Uuid
  module             AllocationModule
  amount             Decimal             @db.Decimal(14, 2)
  note               String?             @db.Text
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  household          Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transaction        Transaction         @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  careRecord         CareRecord?
  wardrobePurchase   WardrobePurchase?
  consumablePurchase ConsumablePurchase?

  @@index([householdId, module, createdAt(sort: Desc)])
  @@index([transactionId])
  @@index([categoryId])
  @@map("transaction_allocations")
}

model BabyProfile {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId    String          @map("household_id") @db.Uuid
  name           String          @db.Text
  birthday       DateTime        @db.Date
  sex            String?         @db.VarChar(16)
  note           String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  household      Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  growthRecords  GrowthRecord[]
  vaccineRecords VaccineRecord[]
  careRecords    CareRecord[]
  wardrobeItems  WardrobeItem[]

  @@index([householdId, birthday])
  @@map("baby_profiles")
}

model GrowthRecord {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId         String      @map("household_id") @db.Uuid
  babyProfileId       String      @map("baby_profile_id") @db.Uuid
  measuredOn          DateTime    @map("measured_on") @db.Date
  weightKg            Decimal     @map("weight_kg") @db.Decimal(6, 3)
  heightCm            Decimal?    @map("height_cm") @db.Decimal(5, 2)
  headCircumferenceCm Decimal?    @map("head_circumference_cm") @db.Decimal(5, 2)
  note                String?     @db.Text
  legacyId            String?     @map("legacy_id") @db.Text
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  household           Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  babyProfile         BabyProfile @relation(fields: [babyProfileId], references: [id], onDelete: Cascade)

  @@index([householdId, measuredOn(sort: Desc)])
  @@index([babyProfileId, measuredOn(sort: Desc)])
  @@map("growth_records")
}

model VaccineCatalog {
  id              String          @id @db.Text
  sortOrder       Int             @unique @map("sort_order")
  ageMonths       Int             @map("age_months")
  ageLabel        String          @map("age_label") @db.Text
  vaccine         String          @db.Text
  dose            String          @db.Text
  funding         String          @db.VarChar(16)
  dateRule        String?         @map("date_rule") @db.Text
  dateOffsetDays  Int             @default(0) @map("date_offset_days")
  source          String          @db.Text
  active          Boolean         @default(true)
  region          String          @db.Text
  scheduleVersion String          @map("schedule_version") @db.Text
  prevents        String          @default("") @db.Text
  aliases         String[]        @default([])
  audience        String?         @db.Text
  scheduleNote    String?         @map("schedule_note") @db.Text
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  records         VaccineRecord[]

  @@index([active, sortOrder])
  @@map("vaccine_catalog")
}

model VaccineRecord {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId    String         @map("household_id") @db.Uuid
  babyProfileId  String         @map("baby_profile_id") @db.Uuid
  vaccineId      String         @map("vaccine_id") @db.Text
  administeredOn DateTime       @map("administered_on") @db.Date
  place          String?        @db.Text
  batchNo        String?        @map("batch_no") @db.Text
  manufacturer   String?        @db.Text
  note           String?        @db.Text
  legacyId       String?        @map("legacy_id") @db.Text
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  household      Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  babyProfile    BabyProfile    @relation(fields: [babyProfileId], references: [id], onDelete: Cascade)
  vaccine        VaccineCatalog @relation(fields: [vaccineId], references: [id], onDelete: Restrict)

  @@unique([babyProfileId, vaccineId, administeredOn])
  @@index([householdId, administeredOn(sort: Desc)])
  @@index([vaccineId])
  @@map("vaccine_records")
}

model CareRecord {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId             String                 @map("household_id") @db.Uuid
  babyProfileId           String                 @map("baby_profile_id") @db.Uuid
  transactionAllocationId String?                @unique @map("transaction_allocation_id") @db.Uuid
  type                    CareRecordType
  occurredAt              DateTime               @map("occurred_at") @db.Timestamptz(3)
  title                   String                 @db.Text
  provider                String?                @db.Text
  note                    String?                @db.Text
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  household               Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  babyProfile             BabyProfile            @relation(fields: [babyProfileId], references: [id], onDelete: Cascade)
  transactionAllocation   TransactionAllocation? @relation(fields: [transactionAllocationId], references: [id], onDelete: SetNull)

  @@index([householdId, occurredAt(sort: Desc)])
  @@index([babyProfileId, occurredAt(sort: Desc)])
  @@map("care_records")
}

model WardrobePurchase {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId             String                 @map("household_id") @db.Uuid
  transactionAllocationId String?                @unique @map("transaction_allocation_id") @db.Uuid
  purchasedAt             DateTime               @map("purchased_at") @db.Timestamptz(3)
  merchant                String?                @db.Text
  note                    String?                @db.Text
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  household               Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactionAllocation   TransactionAllocation? @relation(fields: [transactionAllocationId], references: [id], onDelete: SetNull)
  items                   WardrobeItem[]

  @@index([householdId, purchasedAt(sort: Desc)])
  @@map("wardrobe_purchases")
}

model WardrobeItem {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId        String             @map("household_id") @db.Uuid
  babyProfileId      String?            @map("baby_profile_id") @db.Uuid
  wardrobePurchaseId String?            @map("wardrobe_purchase_id") @db.Uuid
  name               String             @db.Text
  category           String?            @db.Text
  size               String?            @db.Text
  season             String?            @db.Text
  color              String?            @db.Text
  quantity           Int                @default(1)
  status             WardrobeItemStatus @default(ACTIVE)
  note               String?            @db.Text
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  household          Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  babyProfile        BabyProfile?       @relation(fields: [babyProfileId], references: [id], onDelete: SetNull)
  wardrobePurchase   WardrobePurchase?  @relation(fields: [wardrobePurchaseId], references: [id], onDelete: SetNull)

  @@index([householdId, status, category])
  @@index([babyProfileId])
  @@index([wardrobePurchaseId])
  @@map("wardrobe_items")
}

// Retains the existing yudan-wupin products and product codes.
model Product {
  productCode   String                   @id @map("product_code") @db.Text
  householdId   String                   @map("household_id") @db.Uuid
  name          String                   @db.Text
  category      String                   @db.Text
  unit          String                   @db.Text
  spec          String?                  @db.Text
  barcode       String?                  @db.Text
  minStock      Int                      @default(2) @map("min_stock")
  isFavorite    Int                      @default(0) @map("is_favorite")
  isGroupable   Int                      @default(0) @map("is_groupable")
  isActive      Int                      @default(1) @map("is_active")
  sortOrder     Int                      @default(0) @map("sort_order")
  note          String?                  @db.Text
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamp(3)
  household     Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  stockEntries  StockEntry[]
  inventoryLogs InventoryLog[]
  groupItems    ProductGroupItem[]
  purchaseItems ConsumablePurchaseItem[]

  @@index([householdId, isActive, sortOrder])
  @@map("products")
}

model ProductGroup {
  id          Int                @id @default(autoincrement())
  householdId String             @map("household_id") @db.Uuid
  groupCode   String             @unique @map("group_code") @db.Text
  name        String             @db.Text
  description String?            @db.Text
  qrTokenHash String             @unique @map("qr_token") @db.Text
  isActive    Int                @default(1) @map("is_active")
  sortOrder   Int                @default(0) @map("sort_order")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamp(3)
  household   Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items       ProductGroupItem[]

  @@index([householdId, isActive, sortOrder])
  @@map("product_groups")
}

model ProductGroupItem {
  id             Int          @id @default(autoincrement())
  householdId    String       @map("household_id") @db.Uuid
  groupCode      String       @map("group_code") @db.Text
  productCode    String?      @map("product_code") @db.Text
  customName     String?      @map("custom_name") @db.Text
  customCategory String?      @map("custom_category") @db.Text
  customSpec     String?      @map("custom_spec") @db.Text
  customUnit     String?      @map("custom_unit") @db.Text
  suggestedQty   Int          @default(1) @map("suggested_qty")
  note           String?      @db.Text
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamp(3)
  household      Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  group          ProductGroup @relation(fields: [groupCode], references: [groupCode], onDelete: Cascade)
  product        Product?     @relation(fields: [productCode], references: [productCode], onDelete: Restrict)

  @@unique([groupCode, productCode])
  @@index([householdId, groupCode, sortOrder])
  @@index([productCode])
  @@map("product_group_items")
}

// New UI calls this a stock entry. `batch_code` is a hidden compatibility key.
model StockEntry {
  id                Int                     @id @default(autoincrement())
  householdId       String                  @map("household_id") @db.Uuid
  legacyBatchCode   String                  @unique @map("batch_code") @db.Text
  productCode       String                  @map("product_code") @db.Text
  purchaseItemId    String?                 @map("purchase_item_id") @db.Uuid
  initialQuantity   Int                     @map("init_quantity")
  availableQuantity Int                     @map("available_quantity")
  expiryDate        DateTime?               @map("expiry_date") @db.Timestamp(3)
  storageLocation   String?                 @map("storage_location") @db.Text
  purchaseSource    String?                 @map("purchase_source") @db.Text
  purchasePrice     Decimal?                @map("purchase_price") @db.Decimal(14, 2)
  unitPrice         Decimal?                @map("unit_price") @db.Decimal(14, 4)
  note              String?                 @db.Text
  status            String                  @default("ACTIVE") @db.Text
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamp(3)
  household         Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  product           Product                 @relation(fields: [productCode], references: [productCode], onDelete: Restrict)
  purchaseItem      ConsumablePurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)
  logs              InventoryLog[]

  @@index([householdId, productCode, status, expiryDate])
  @@index([purchaseItemId])
  @@map("inventory_batches")
}

model InventoryLog {
  id              Int           @id @default(autoincrement())
  householdId     String        @map("household_id") @db.Uuid
  productCode     String        @map("product_code") @db.Text
  legacyBatchCode String?       @map("batch_code") @db.Text
  actionType      String        @map("action_type") @db.Text
  quantity        Int
  beforeQuantity  Int?          @map("before_quantity")
  afterQuantity   Int?          @map("after_quantity")
  reason          String?       @db.Text
  note            String?       @db.Text
  details         Json?
  reversedLogId   Int?          @unique @map("reversed_log_id")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  household       Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productCode], references: [productCode], onDelete: Restrict)
  stockEntry      StockEntry?   @relation(fields: [legacyBatchCode], references: [legacyBatchCode], onDelete: SetNull)
  reversedLog     InventoryLog? @relation("inventory_log_reversal", fields: [reversedLogId], references: [id], onDelete: Restrict)
  reversal        InventoryLog? @relation("inventory_log_reversal")

  @@index([householdId, createdAt(sort: Desc)])
  @@index([productCode, createdAt(sort: Desc)])
  @@index([legacyBatchCode, createdAt(sort: Desc)])
  @@map("inventory_logs")
}

model ConsumablePurchase {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId             String                   @map("household_id") @db.Uuid
  transactionAllocationId String?                  @unique @map("transaction_allocation_id") @db.Uuid
  purchasedAt             DateTime                 @map("purchased_at") @db.Timestamptz(3)
  merchant                String?                  @db.Text
  note                    String?                  @db.Text
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  household               Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactionAllocation   TransactionAllocation?   @relation(fields: [transactionAllocationId], references: [id], onDelete: SetNull)
  items                   ConsumablePurchaseItem[]

  @@index([householdId, purchasedAt(sort: Desc)])
  @@map("consumable_purchases")
}

model ConsumablePurchaseItem {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId          String             @map("household_id") @db.Uuid
  consumablePurchaseId String             @map("consumable_purchase_id") @db.Uuid
  productCode          String?            @map("product_code") @db.Text
  description          String             @db.Text
  quantity             Decimal            @db.Decimal(12, 3)
  unitPrice            Decimal?           @map("unit_price") @db.Decimal(14, 4)
  lineAmount           Decimal            @map("line_amount") @db.Decimal(14, 2)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  household            Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  purchase             ConsumablePurchase @relation(fields: [consumablePurchaseId], references: [id], onDelete: Cascade)
  product              Product?           @relation(fields: [productCode], references: [productCode], onDelete: SetNull)
  stockEntries         StockEntry[]

  @@index([householdId, createdAt(sort: Desc)])
  @@index([consumablePurchaseId])
  @@index([productCode])
  @@map("consumable_purchase_items")
}

model MediaAsset {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId      String          @map("household_id") @db.Uuid
  uploadedByUserId String          @map("uploaded_by_user_id") @db.Uuid
  objectKey        String          @unique @map("object_key") @db.Text
  bucket           String          @db.Text
  visibility       MediaVisibility @default(PRIVATE)
  mimeType         String          @map("mime_type") @db.Text
  byteSize         BigInt          @map("byte_size")
  checksumSha256   String?         @map("checksum_sha256") @db.VarChar(64)
  width            Int?
  height           Int?
  metadata         Json?
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz(3)
  household        Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  uploadedBy       AppUser         @relation("media_uploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  links            MediaLink[]

  @@index([householdId, createdAt(sort: Desc)])
  @@index([uploadedByUserId])
  @@map("media_assets")
}

model MediaLink {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId  String     @map("household_id") @db.Uuid
  mediaAssetId String     @map("media_asset_id") @db.Uuid
  entityType   String     @map("entity_type") @db.VarChar(64)
  entityId     String     @map("entity_id") @db.Text
  purpose      String?    @db.VarChar(64)
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  household    Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, entityType, entityId, purpose])
  @@index([householdId, entityType, entityId, sortOrder])
  @@map("media_links")
}

model LegacyImportMap {
  id            BigInt   @id @default(autoincrement())
  sourceProject String   @map("source_project") @db.VarChar(64)
  sourceTable   String   @map("source_table") @db.VarChar(96)
  sourceId      String   @map("source_id") @db.Text
  targetTable   String   @map("target_table") @db.VarChar(96)
  targetId      String   @map("target_id") @db.Text
  sourceHash    String?  @map("source_hash") @db.VarChar(128)
  importedAt    DateTime @default(now()) @map("imported_at") @db.Timestamptz(3)

  @@unique([sourceProject, sourceTable, sourceId])
  @@index([targetTable, targetId])
  @@map("legacy_import_maps")
}
